# Backend Environment Variables

# OpenAI API Key (Whisper API用)
OPENAI_API_KEY=your_openai_api_key_here

# Notion Integration
NOTION_TOKEN=your_notion_integration_token_here
NOTION_USER_DATABASE_ID=your_user_database_id_here
NOTION_CONVERSATION_DB_ID=your_conversation_logs_database_id_here
NOTION_FEEDBACK_DB_ID=your_feedback_logs_database_id_here
NOTION_LESSONS_DB_ID=your_lessons_database_id_here

# Authentication (認証設定)
JWT_SECRET_KEY=your-secret-key-change-this-in-production
COOKIE_SECURE=false  # 開発環境ではfalse、本番環境ではtrue

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000

# Server Configuration
PORT=8000
HOST=0.0.0.0

# Stripe Configuration
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here

# Google Play Billing (Android版の定期購入)
# サービスアカウントのJSON鍵（JSONそのもの、またはbase64）。Play Consoleの「APIアクセス」で権限付与する
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
GOOGLE_PLAY_PACKAGE_NAME=com.yasuhiro.watanabe.deepspeak
# 商品ID:プラン名 のカンマ区切り（既定値は backend/app/services/google_play_service.py を参照）
# GOOGLE_PLAY_PRODUCT_PLAN_MAP=deepspeak_basic_monthly:Basic,deepspeak_basic_yearly:Basic,deepspeak_premium_monthly:Premium,deepspeak_premium_yearly:Premium
# Pub/Sub push の URL に ?token=<この値> を付けて登録する
GOOGLE_PLAY_RTDN_SECRET=
# Notionユーザー DB に追加する項目名（Play Purchase Token=テキスト、Subscription Source=セレクト[Stripe/Play]）
# NOTION_PLAY_PURCHASE_TOKEN_PROPERTY=Play Purchase Token
# NOTION_SUBSCRIPTION_SOURCE_PROPERTY=Subscription Source
